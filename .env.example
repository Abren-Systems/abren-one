# ---------------------------------------------------------------------------
# Abren One — Environment Variables Template
# ---------------------------------------------------------------------------

# Django
DJANGO_SECRET_KEY=insecure-dev-secret-key-change-in-production
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL 18+)
POSTGRES_IMAGE=postgres:18-alpine
USE_POSTGRES=1
DATABASE_NAME=abren_one
DATABASE_USER=abren
DATABASE_PASSWORD=abren_secret_dev_pwd
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Production Extras
# DJANGO_SETTINGS_MODULE=config.settings.production
